{
  "name": "zl-wa-login-probe",
  "version": "0.1.0",
  "private": true,
  "description": "Isolated WhatsApp protocol login validation",
  "author": "ZL-WA",
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.mjs",
    "pack": "electron-builder --win zip --x64 --publish never"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "pino": "9.14.0",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "electron": "43.3.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.zlwa.loginprobe",
    "productName": "ZL-WA Login Probe",
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "files": [
      "main.mjs",
      "backend.mjs",
      "preload.cjs",
      "index.html",
      "renderer.js",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "zip",
      "signAndEditExecutable": false,
      "artifactName": "ZL-WA-Login-Probe-0.1.0-win-x64.zip"
    }
  }
}
